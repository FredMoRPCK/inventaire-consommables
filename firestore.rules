rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function connecte() { return request.auth != null; }
    // Administrateurs : doit correspondre à ADMINS dans app.js
    function admin() { return connecte() && request.auth.token.email.lower() in ['frederic.morin@ropack.com']; }

    match /articles/{id} {
      allow read: if connecte();
      allow create, update: if connecte()
        && request.resource.data.code is string
        && request.resource.data.nom is string
        && request.resource.data.qte is number;
      allow delete: if admin();
    }
    // L'historique est ajouté seulement ; seul l'administrateur peut le supprimer
    match /mouvements/{id} {
      allow read: if connecte();
      allow create: if connecte();
      allow update: if false;
      allow delete: if admin();
    }
  }
}
